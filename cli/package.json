{
  "name": "@giglabo/heretic-cli",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist/heretic-cli.js"
  ],
  "bin": {
    "heretic-cli": "./dist/heretic-cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "bundle": "bun build ./src/index.ts --outfile dist/heretic-cli.js --target bun --bundle --external dockerode --external ssh2",
    "prepublishOnly": "bun run bundle",
    "build": "bun build ./src/index.ts --compile --outfile dist/heretic-cli",
    "build:linux-x64": "bun build ./src/index.ts --compile --target=bun-linux-x64 --outfile dist/heretic-cli-linux-x64",
    "build:linux-arm64": "bun build ./src/index.ts --compile --target=bun-linux-arm64 --outfile dist/heretic-cli-linux-arm64",
    "build:macos-x64": "bun build ./src/index.ts --compile --target=bun-darwin-x64 --outfile dist/heretic-cli-macos-x64",
    "build:macos-arm64": "bun build ./src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/heretic-cli-macos-arm64",
    "build:windows": "bun build ./src/index.ts --compile --target=bun-windows-x64 --outfile dist/heretic-cli-windows.exe",
    "build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:macos-x64 && bun run build:macos-arm64 && bun run build:windows",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bun": "^1.1.14",
    "@types/dockerode": "^4.0.1",
    "@types/inquirer": "^9.0.9",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "dockerode": "^4.0.9",
    "inquirer": "^13.2.1",
    "js-yaml": "^4.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  }
}
