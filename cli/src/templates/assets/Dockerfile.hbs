# Heretic Agent Image
# Auto-generated by heretic-cli image build
#
# Agent(s): {{{agentsList}}}
#

ARG BASE_IMAGE={{{defaultBaseImage}}}
FROM ${BASE_IMAGE}

ARG TARGETARCH
ARG AGENT_USER={{{agentUser}}}
ARG AGENT_UID={{{agentUid}}}
ARG AGENT_GID={{{agentGid}}}
ARG AGENT_TYPE={{{agentType}}}

LABEL org.opencontainers.image.title="Heretic Agent ({{{agentLabel}}})"
LABEL org.opencontainers.image.description="Unified agent with configurable tools (agent: {{{agentLabel}}})"
LABEL org.opencontainers.image.vendor="Heretic"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    AGENT_TYPE="{{{agentType}}}"

# Install base dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    jq \
    xz-utils \
    gnupg \
    unzip \
    openssh-client \
    vim \
    && rm -rf /var/lib/apt/lists/*

{{#if isUbuntuBase}}
# Configure locales for Ubuntu
RUN apt-get update && apt-get install -y --no-install-recommends \
    locales \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

{{/if}}
{{#if isNodeBase}}
# Enable corepack for pnpm/yarn (Node base image)
RUN corepack enable

{{else}}
# Install Node.js {{{nodeVersion}}}.x (required for agent CLIs)
RUN curl -fsSL https://deb.nodesource.com/setup_{{{nodeVersion}}}.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Enable corepack for pnpm/yarn
RUN corepack enable

{{/if}}
{{#if withPython}}
{{#if pythonVersionSpecific}}
# Install Python {{{pythonVersion}}} from deadsnakes PPA
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    curl \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python{{{pythonVersion}}} \
    python{{{pythonVersion}}}-venv \
    python{{{pythonVersion}}}-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python{{{pythonVersion}}} /usr/bin/python3 \
    && ln -sf /usr/bin/python{{{pythonVersion}}} /usr/bin/python \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python{{{pythonVersion}}}

{{else}}
# Install Python 3 and tools (distro default)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

{{/if}}
# Install Python development tools
RUN pip3 install --break-system-packages --no-cache-dir \
    poetry \
    pytest \
    black \
    ruff \
    mypy \
    || pip3 install --no-cache-dir \
    poetry \
    pytest \
    black \
    ruff \
    mypy

{{/if}}
{{#if withGo}}
# Install Go {{{goVersion}}}
RUN case "${TARGETARCH}" in \
        amd64) GO_ARCH="amd64" ;; \
        arm64) GO_ARCH="arm64" ;; \
        *) GO_ARCH="amd64" ;; \
    esac \
    && curl -fsSL "https://go.dev/dl/go{{{goVersion}}}.linux-${GO_ARCH}.tar.gz" \
    | tar -C /usr/local -xzf - \
    && ln -sf /usr/local/go/bin/go /usr/local/bin/go \
    && ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt

ENV PATH="/usr/local/go/bin:${PATH}"

{{/if}}
{{#if withJava}}
# Install Java {{{javaVersion}}} (Eclipse Temurin)
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN case "${TARGETARCH}" in \
        amd64) JAVA_ARCH="x64" ;; \
        arm64) JAVA_ARCH="aarch64" ;; \
        *) JAVA_ARCH="x64" ;; \
    esac \
    && mkdir -p /opt/java \
    && cd /opt/java \
    && wget -q "https://github.com/adoptium/temurin{{{javaVersion}}}-binaries/releases/download/jdk-{{{javaVersion}}}.0.2%2B13/OpenJDK{{{javaVersion}}}U-jdk_${JAVA_ARCH}_linux_hotspot_{{{javaVersion}}}.0.2_13.tar.gz" \
    && tar -xzf OpenJDK*.tar.gz \
    && rm OpenJDK*.tar.gz \
    && mv jdk* jdk \
    && ln -sf /opt/java/jdk/bin/* /usr/local/bin/

ENV JAVA_HOME="/opt/java/jdk"
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Install Maven 3.9.6
RUN curl -fsSL "https://dlcdn.apache.org/maven/maven-3/3.9.6/binaries/apache-maven-3.9.6-bin.tar.gz" \
    | tar -C /opt -xzf - \
    && ln -sf /opt/apache-maven-3.9.6/bin/mvn /usr/local/bin/mvn

# Install Gradle 8.5
RUN curl -fsSL "https://services.gradle.org/distributions/gradle-8.5-bin.zip" -o /tmp/gradle.zip \
    && unzip -q /tmp/gradle.zip -d /opt \
    && rm /tmp/gradle.zip \
    && ln -sf /opt/gradle-8.5/bin/gradle /usr/local/bin/gradle

{{/if}}
{{#if withRust}}
# Install Rust {{{rustVersion}}}
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain {{{rustVersion}}}
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup component add rustfmt clippy

{{/if}}
{{#if withDocker}}
# Install Docker CLI for Docker-in-Docker / Docker-outside-of-Docker
RUN . /etc/os-release \
    && curl -fsSL "https://download.docker.com/linux/${ID}/gpg" \
    | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/${ID} ${VERSION_CODENAME} stable" \
    | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

{{/if}}
{{#if withGithubCli}}
# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

{{/if}}
# {{{npmInstallComment}}}
RUN npm install -g {{{npmPackages}}}

# Tool backends — runtime wrapper generation in entrypoint.sh
COPY sidecar-exec /opt/sidecar/sidecar-exec
COPY ssh-exec /opt/sidecar/ssh-exec
RUN chmod +x /opt/sidecar/sidecar-exec /opt/sidecar/ssh-exec \
    && mkdir -p /opt/sidecar/wrappers
ENV PATH="/opt/sidecar/wrappers:${PATH}"

# Create agent user
RUN (userdel -r node 2>/dev/null || true) \
    && groupadd -g ${AGENT_GID} ${AGENT_USER} \
    && useradd -m -s /bin/bash -u ${AGENT_UID} -g ${AGENT_GID} ${AGENT_USER}

{{#if withRust}}
# Copy Rust installation for agent user
RUN cp -r /root/.cargo /home/${AGENT_USER}/.cargo \
    && cp -r /root/.rustup /home/${AGENT_USER}/.rustup 2>/dev/null || true \
    && chown -R ${AGENT_USER}:${AGENT_USER} /home/${AGENT_USER}/.cargo \
    && echo 'export PATH="/home/${AGENT_USER}/.cargo/bin:${PATH}"' >> /home/${AGENT_USER}/.bashrc

{{/if}}
# {{{dirSectionComment}}}
RUN mkdir -p {{{agentDirs}}} \
    && chown -R ${AGENT_USER}:${AGENT_USER} /home/${AGENT_USER} /workspace

USER ${AGENT_USER}
WORKDIR /home/${AGENT_USER}

# Runtime environment variables
ENV API_TIMEOUT_MS="3000000"
ENV GH_TOKEN=""
ENV TASK_ID=""
ENV STEP_NAME=""
ENV REPO_PATH="/workspace"
ENV PROMPT_FILE=""
ENV AGENT_ARGS=""
ENV AGENT_OUTPUT_FORMAT="stream-json"

# Default command - interactive shell
CMD ["/bin/bash"]
