#!/bin/bash
# sidecar-exec — route a build/tool command to an HTTP build sidecar.
#
# Contract (see cli/docs/tool-execution-backends-plan.md and the
# tool-execution-backends spec, 02-contracts §4):
#
#   sidecar-exec <runtime> <command> [args...]
#
# The wrappers generated by entrypoint.sh call this as, e.g.:
#   exec /opt/sidecar/sidecar-exec node npm install
#
# Environment:
#   BUILD_SIDECARS          (required) JSON: {"<runtime>":{"internal_url":"http://host:port"}}
#   SIDECAR_TIMEOUT         seconds sent to the server (default 600; the reference
#                           client used 300 which silently killed long builds — gap C-5)
#   SIDECAR_CWD             working dir sent to the server (default: current dir)
#   SIDECAR_STREAM          1 = use /exec/stream (SSE) instead of /exec
#   SIDECAR_ENV_PASSTHROUGH comma-separated allowlist of env var names forwarded to the
#                           build (gap C-8). NEVER forward the whole environment — the
#                           agent holds ANTHROPIC_API_KEY / GH_TOKEN.
#
# Exit codes:
#   the command's own exit code on success/failure;
#   124 on timeout (GNU timeout convention — gap C-6, was an ambiguous 255);
#   255 on other server-side start failures (exit_code -1);
#   1   on transport/config errors.

set -uo pipefail

command -v curl >/dev/null 2>&1 || { echo "sidecar-exec: 'curl' not found in image" >&2; exit 1; }
command -v jq   >/dev/null 2>&1 || { echo "sidecar-exec: 'jq' not found in image" >&2; exit 1; }

if [[ $# -lt 2 ]]; then
    echo "Usage: sidecar-exec <runtime> <command> [args...]" >&2
    exit 1
fi

: "${BUILD_SIDECARS:?sidecar-exec: BUILD_SIDECARS is not set}"

RUNTIME="$1"; shift    # remaining "$@" is the command + args

TIMEOUT="${SIDECAR_TIMEOUT:-600}"
CWD="${SIDECAR_CWD:-$(pwd)}"
STREAM="${SIDECAR_STREAM:-0}"

# Resolve the sidecar URL for this runtime. Only `internal_url` is read (contract §1).
URL=$(jq -r --arg rt "$RUNTIME" '.[$rt].internal_url // empty' <<<"$BUILD_SIDECARS" 2>/dev/null)
if [[ -z "$URL" ]]; then
    available=$(jq -r 'keys | join(", ")' <<<"$BUILD_SIDECARS" 2>/dev/null || echo "<unparseable BUILD_SIDECARS>")
    echo "sidecar-exec: no sidecar available for runtime '$RUNTIME' (available: ${available:-none})" >&2
    exit 1
fi

# Build the request body with jq so any characters in argv/cwd/env are encoded safely.
#
# Encode argv incrementally with `--arg` instead of jq's `$ARGS.positional --args`.
# jq < 1.7 (Debian bookworm — the builder image base — ships jq 1.6) does NOT stop
# option parsing after `--args`, so it chokes on any argument that looks like a flag:
# `npm install --save-dev`, `go build -o bin`, `pip install -r req.txt`, `cargo build
# --release` would all die with "Unknown option". `--arg NAME VALUE` always consumes
# VALUE positionally, so leading dashes (and spaces, `=`, quotes) survive intact.
CMD_JSON='[]'
for _arg in "$@"; do
    CMD_JSON=$(jq -c --arg x "$_arg" '. + [$x]' <<<"$CMD_JSON")
done

ENV_JSON=$(jq -cn '{}')
if [[ -n "${SIDECAR_ENV_PASSTHROUGH:-}" ]]; then
    IFS=',' read -ra _names <<<"$SIDECAR_ENV_PASSTHROUGH"
    for _name in "${_names[@]}"; do
        _name="${_name//[[:space:]]/}"
        [[ -z "$_name" ]] && continue
        if [[ -n "${!_name+x}" ]]; then
            ENV_JSON=$(jq -c --arg k "$_name" --arg v "${!_name}" '. + {($k): $v}' <<<"$ENV_JSON")
        fi
    done
fi

BODY=$(jq -cn \
    --argjson cmd "$CMD_JSON" \
    --arg cwd "$CWD" \
    --argjson timeout "$TIMEOUT" \
    --argjson env "$ENV_JSON" \
    '{cmd: $cmd, cwd: $cwd, timeout: $timeout, env: $env}')

# Give curl a deadline slightly longer than the server-side timeout.
MAX_TIME=$((TIMEOUT + 30))

if [[ "$STREAM" == "1" ]]; then
    # ---- Streaming (SSE) mode ----------------------------------------------
    # The `while` reads from a process-substitution (< <(...)) so it runs in the
    # CURRENT shell — the reference client piped into `while`, whose subshell
    # discarded the captured exit code and made every streamed build exit 0
    # (gap C-3). This version propagates the real exit code.
    exit_code=0
    got_exit=0
    while IFS= read -r line; do
        [[ "$line" == data:* ]] || continue
        data="${line#data:}"
        data="${data# }"
        [[ -z "$data" ]] && continue
        type=$(jq -r '.type // empty' <<<"$data" 2>/dev/null)
        content=$(jq -r '.data // ""' <<<"$data" 2>/dev/null)
        case "$type" in
            stdout) printf '%s\n' "$content" ;;
            stderr) printf '%s\n' "$content" >&2 ;;
            exit)   exit_code="$content"; got_exit=1 ;;
            error)  printf 'sidecar-exec: %s\n' "$content" >&2 ;;
        esac
    done < <(curl -sS -N -m "$MAX_TIME" -X POST "$URL/exec/stream" \
                  -H 'Content-Type: application/json' -d "$BODY")

    if [[ "$got_exit" == "0" ]]; then
        echo "sidecar-exec: stream ended without an exit frame (connection to $URL lost?)" >&2
        exit 1
    fi
    [[ "$exit_code" == "-1" ]] && exit 255
    exit "$exit_code"
fi

# ---- Blocking mode ---------------------------------------------------------
resp=$(curl -sS -m "$MAX_TIME" -X POST "$URL/exec" \
            -H 'Content-Type: application/json' -d "$BODY")
if [[ $? -ne 0 ]]; then
    echo "sidecar-exec: failed to connect to sidecar at $URL" >&2
    exit 1
fi

# The server returns JSON only when the request parsed; a 4xx returns plain text.
if ! jq -e . >/dev/null 2>&1 <<<"$resp"; then
    echo "sidecar-exec: unexpected response from $URL: $resp" >&2
    exit 1
fi

exit_code=$(jq -r '.exit_code // 0' <<<"$resp")
error_msg=$(jq -r '.error // empty' <<<"$resp")

# Print stdout then stderr with -j so internal newlines survive (trailing-newline
# collapse of the reference client is documented as gap C-19).
jq -j '.output // ""' <<<"$resp"
jq -j '.stderr // ""' <<<"$resp" >&2

if [[ "$exit_code" == "-1" ]]; then
    if [[ "$error_msg" == *"timed out"* || "$error_msg" == *"timeout"* ]]; then
        echo "sidecar-exec: command timed out after ${TIMEOUT}s" >&2
        exit 124
    fi
    [[ -n "$error_msg" ]] && echo "sidecar-exec: $error_msg" >&2
    exit 255
fi

exit "$exit_code"
