# Heretic Agent - Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# Required Configuration
# =============================================================================

# Anthropic API Key (required)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_AUTH_TOKEN=your_anthropic_api_key_here

# =============================================================================
# Optional Configuration
# =============================================================================

# API Configuration
ANTHROPIC_BASE_URL=https://api.anthropic.com
API_TIMEOUT_MS=3000000

# Image Configuration
BASE_IMAGE=node:22-bookworm-slim
IMAGE_NAME=heretic-agent
IMAGE_TAG=latest

# Tool Installation (true/false)
INSTALL_PYTHON=false
INSTALL_NODE=false
INSTALL_GO=false
INSTALL_JAVA=false
INSTALL_RUST=false
INSTALL_DOCKER=false
INSTALL_GH_CLI=true

# Workspace Path
WORKSPACE_PATH=./workspace

# Git Configuration
GH_TOKEN=your_github_token_here
GIT_AUTHOR_NAME=Heretic Agent
GIT_AUTHOR_EMAIL=agent@example.com

# Sidecar Configuration (JSON format)
# Example with local sidecars:
# BUILD_SIDECARS={"python":{"internal_url":"http://python-sidecar:8080"},"node":{"internal_url":"http://node-sidecar:8080"}}
BUILD_SIDECARS=
SIDECAR_TIMEOUT=600

# SSH Backend Configuration
# Set SSH_HOST to route tool commands to a remote host via SSH
# Priority: fat/local binary > sidecar > SSH
SSH_HOST=
SSH_PORT=22
SSH_USER=agent
SSH_KEY_PATH=/home/agent/.ssh/id_rsa
SSH_KEY_FILE=
SSH_HOST_CWD=

# Claude Settings
CLAUDE_SETTINGS_PATH=./settings.json

# MCP Configuration
MCP_CONFIG_PATH=./mcp.json

# Workflow Configuration (used by orchestrator)
TASK_ID=
STEP_NAME=
PROMPT_FILE=
AGENT_ARGS=
AGENT_OUTPUT_FORMAT=stream-json
