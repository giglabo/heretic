            ;;
    esac

    # Build
    echo "Building image..."
    cd "$build_dir"

    local build_args=(
        --build-arg "BASE_IMAGE=${BASE_IMAGE}"
        --build-arg "AGENT_USER=${AGENT_USER}"
        --build-arg "AGENT_UID=${AGENT_UID}"
        --build-arg "AGENT_GID=${AGENT_GID}"
