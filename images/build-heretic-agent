    image_suffix=""
    [[ "$agent" != "claude" ]] && image_suffix="-${agent}"
    final_name="${IMAGE_NAME}${image_suffix}:${IMAGE_TAG}"
    [[ -n "$REGISTRY" ]] && final_name="${REGISTRY}/${final_name}"

