echo "=== Heretic Agent Image Builder ==="
echo ""

# Check if combined mode is requested
if [[ "$COMBINED" == "true" ]] && [[ ${#AGENT_TYPES[@]} -gt 1 ]]; then
    # Combined mode - all agents in one image
    build_combined_agent

    final_name="${IMAGE_NAME}:${IMAGE_TAG}"
