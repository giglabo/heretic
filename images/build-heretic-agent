    echo "Usage examples:"
    echo "  # Interactive mode - specify agent type at runtime"
    for agent in "${AGENT_TYPES[@]}"; do
        echo "  docker run -it --rm -e AGENT_TYPE=${agent} ${final_name}"
    done
    echo ""
    echo "  # Workflow mode"
    echo "  docker run -it --rm \\"
    echo "    -e AGENT_TYPE=claude \\"
    echo "    -e PROMPT_FILE=/workspace/prompt.md \\"
    echo "    -e REPO_PATH=/workspace \\"
    echo "    -v \$(pwd):/workspace \\"
    echo "    --entrypoint /home/agent/entrypoint.sh \\"
    echo "    ${final_name}"
    echo ""
elif [[ ${#AGENT_TYPES[@]} -gt 1 ]]; then
    # Multiple agents - build separate images
    echo "Building ${#AGENT_TYPES[@]} agent types: ${AGENT_TYPES[*]}"
    for agent in "${AGENT_TYPES[@]}"; do
        echo ""
        echo "=================================================="
        build_agent "$agent"
        echo "=================================================="
        echo ""
    done
    echo "All ${#AGENT_TYPES[@]} agent images built successfully!"
    echo ""
    echo "Built images:"
    for agent in "${AGENT_TYPES[@]}"; do
        image_suffix=""
        [[ "$agent" != "claude" ]] && image_suffix="-${agent}"
        final_name="${IMAGE_NAME}${image_suffix}:${IMAGE_TAG}"
        [[ -n "$REGISTRY" ]] && final_name="${REGISTRY}/${final_name}"
        echo "  - ${final_name}"
