# Heretic Agent — Custom Extensions
# Generated by: heretic-cli image customize
#
# This Dockerfile layers your customizations on top of a base heretic agent image.
# Edit freely — it's a standard Dockerfile.
#
# Build with:
#   heretic-cli image apply
#   heretic-cli image apply --name my-custom-agent --tag v1
#
# Or manually:
#   docker build -t my-custom-agent -f .heretic/Dockerfile.custom .

ARG BASE_IMAGE=heretic-agent:latest
FROM ${BASE_IMAGE}

ARG AGENT_USER=agent

# =============================================================================
# Root section — install system packages, global tools
# Runs as root. Use this for apt-get, global pip/npm installs, etc.
# =============================================================================
USER root

# Example: Pin pnpm version
# RUN corepack install -g pnpm@10.29.2

# Example: Install system packages
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     postgresql-client \
#     redis-tools \
#     && rm -rf /var/lib/apt/lists/*

# Example: Install Python packages globally
# RUN pip3 install --break-system-packages --no-cache-dir \
#     pandas numpy scikit-learn

# Example: Install additional Node.js tools
# RUN npm install -g turbo nx

# Install pnpm via corepack
RUN corepack enable && corepack install -g pnpm@10.29.3

# =============================================================================
# Agent section — user-level configuration, dotfiles, preferences
# Runs as the agent user (default: agent, UID 1000).
# =============================================================================
USER ${AGENT_USER}

# Example: Copy tool configuration files
# COPY .tool-versions /home/agent/.tool-versions

# Example: Set up git config
# RUN git config --global pull.rebase true

# Example: Pre-install project dependencies (caches in image layer)
# COPY package.json /tmp/package.json
# RUN cd /tmp && npm install && rm package.json
